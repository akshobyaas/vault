# ─────────────────────────────────────────────────────────────
#  My Vault — environment variables
#
#  On Vercel: add each of these under Settings → Environment Variables
#  (tick Production and Preview), then redeploy.
#  For local testing with `vercel dev`: copy this file to .env and fill it in.
#  NEVER commit .env — it's in .gitignore.
# ─────────────────────────────────────────────────────────────

# The password you type into the vault. Long and random, at least 20 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
VAULT_API_KEY=

# Google Sheet ID — the part of the sheet URL between /d/ and /edit (not the whole URL)
GOOGLE_SHEET_ID=

# OAuth client from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token from the OAuth Playground, with both scopes:
#   https://www.googleapis.com/auth/spreadsheets
#   https://www.googleapis.com/auth/drive.file
GOOGLE_REFRESH_TOKEN=

# Optional (Production only): your site's address, so browsers only allow API calls from it.
# Leave unset for previews and local testing.
ALLOWED_ORIGIN=https://your-vault.vercel.app

# Not needed: a Google *API key*. The vault only uses OAuth — don't create or commit one.
